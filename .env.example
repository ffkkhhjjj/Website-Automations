# ================================================================================
# Local Growth Engine — environment variables
# Copy to .env and adjust. Everything needed to run locally is listed below;
# integration credentials are NOT required for local development or verification.
# ================================================================================

# --- Server (used by later briefs; not required yet) ---
PORT=3000
NODE_ENV=development

# --- Database ---
# Used by drizzle-kit (migrate/generate) and the seed/verify scripts.
# The default (below) matches docker-compose.yml and the local dev Postgres.
DATABASE_URL=postgres://lge:lge@localhost:5432/lge
# Set to true when connecting to a managed Postgres that requires SSL (e.g. production).
DATABASE_SSL=false
# Maximum connections for the app pool (later briefs).
DATABASE_POOL_MAX=10

# --- Auth (later brief — requires configuration) ---
# Session/secret signing key. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- External integrations (later briefs — requires configuration) ---
# No fake integrations: until a real credential is supplied here AND the matching
# provider module is implemented, these features stay disabled/marked unconfigured.
# Lead/contact enrichment provider key.
ENRICHMENT_API_KEY=
# Email sending provider key (outreach + follow-ups).
EMAIL_API_KEY=
# Demo website hosting provider key.
DEMO_HOSTING_API_KEY=
# Production website deployment provider key.
DEPLOYMENT_API_KEY=

# --- Reprocessing / operations (optional) ---
LOG_LEVEL=info