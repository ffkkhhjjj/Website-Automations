# ================================================================================
# Local Growth Engine — environment variables
# Copy to .env and adjust. Everything needed to run locally is listed below;
# integration credentials are NOT required for local development or verification.
# ================================================================================

# --- Server (used by later briefs; not required yet) ---
PORT=3000
NODE_ENV=development

# --- Database ---
# Used by drizzle-kit (migrate/generate) and the seed/verify scripts.
# The default (below) matches docker-compose.yml and the local dev Postgres.
DATABASE_URL=postgres://lge:lge@localhost:5432/lge
# Set to true when connecting to a managed Postgres that requires SSL (e.g. production).
DATABASE_SSL=false
# Maximum connections for the app pool (later briefs).
DATABASE_POOL_MAX=10

# --- Auth (requires configuration for real use) ---
# Owner account bootstrap (npm run auth:bootstrap):
#   - Idempotent: if OWNER_EMAIL already exists, the script skips and never
#     touches the existing password.
#   - No public signup exists; this is the ONLY way to create the owner account.
# OWNER_PASSWORD is never stored/logged in plaintext (bcrypt hash, 12 rounds).
OWNER_EMAIL=
# Pick a strong password — min length configurable with OWNER_MIN_PASSWORD_LENGTH.
OWNER_PASSWORD=
# JWT signing secret. REQUIRED in production — generate with: openssl rand -hex 32
# The server refuses to start in NODE_ENV=production without it.
JWT_SECRET=
# Access token TTL (jsonwebtoken expiresIn format).
JWT_EXPIRES_IN=15m
# Refresh token lifetime in days (session rows expire after this).
REFRESH_TOKEN_TTL_DAYS=30
# Per-IP rate limits on auth routes.
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW=1 minute
AUTH_REFRESH_RATE_LIMIT_MAX=60
AUTH_REFRESH_RATE_LIMIT_WINDOW=1 minute
AUTH_GLOBAL_RATE_LIMIT_MAX=300
# Minimum password length enforced by auth:bootstrap.
OWNER_MIN_PASSWORD_LENGTH=12
# --- Server-side API keys ---
# API keys are created at runtime (POST /auth/keys, admin scope); the raw key is
# returned exactly once and only its SHA-256 hash is stored. No env var needed
# to run — see README "API keys".

# --- External integrations (requires configuration — no fake integrations) ---
# These become active ONLY when ALL of the following hold:
#   1. a real provider is implemented in src/integrations/providers/ and
#      registered in src/integrations/registry.ts,
#   2. the matching system_settings key (integrations.<module>.provider) is set
#      to that provider's id (via the Settings API),
#   3. the credential below is present in env.
# Until then each module reports `configured:false`, `requiresConfiguration:true`
# from GET /api/integrations/status, and the NotConfiguredProvider THROWS on use
# (methods never return fake success).
# Lead/contact enrichment provider key (module: enrichment).
ENRICHMENT_API_KEY=
# Outreach/follow-up email provider key (module: email). SMTP not offered yet —
# a future provider may add SMTP_HOST/PORT/USER/… alongside this key.
EMAIL_API_KEY=
# Demo website hosting provider key (module: demo_hosting).
DEMO_HOSTING_API_KEY=
# Production website deployment provider key (module: deployment).
DEPLOYMENT_API_KEY=

# --- AI subjective website evaluator (scoring — requires configuration) ---
# The website-quality engine evaluates the five SUBJECTIVE categories (clarity,
# copy, visual, trust, conversion) through the AiSubjectiveEvaluator interface.
# With none configured, the DETERMINISTIC FALLBACK evaluator is used (fully
# functional, zero AI). These values are only consulted — and the AI evaluator is
# only used — when provider+model+prompt are configured in system_settings
# (ai.evaluator.*) AND an AI_EVALUATOR_API_* credential is present here.
# Do NOT commit a real key. No fake endpoints: leave empty unless a provider is
# actually wired in a later brief.
AI_EVALUATOR_PROVIDER=   # openai | anthropic | none (default none)
AI_EVALUATOR_MODEL=
# Either an API key or a custom endpoint URL (backend reads either; require at
# least one before the AI evaluator counts as configured).
AI_EVALUATOR_API_KEY=
AI_EVALUATOR_API_URL=

# --- Reprocessing / operations (optional) ---
LOG_LEVEL=info